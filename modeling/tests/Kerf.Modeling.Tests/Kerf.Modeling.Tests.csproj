<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The assembly and its namespaces keep Kerf.Modeling's test names: xUnit orders the tests by IDs made from them, and
         the differential run's native log (retired in unit 10Q) was recorded in that order, which decides which test
         logs a shape the tests share (unit 10E) -->
    <AssemblyName>Kerf.Modeling.Tests</AssemblyName>
    <RootNamespace>Kerf.Modeling.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Reference\**" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\..\..\kernel\tests\Shared\NativeStepText.cs" Link="Shared\NativeStepText.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Kerf.Tests.Shared" />
    <Using Include="Kerf.Topology" />
    <Using Include="Kerf.Geometry" />
    <Using Include="Kerf.Color" Alias="Color" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kerf.Modeling\Kerf.Modeling.csproj" />
    <!-- Users' cases (unit 13C): UserCasesTests checks each gives its fixed result; its data comes with it -->
    <ProjectReference Include="..\..\..\kernel\benchmarks\Kerf.UserCases\Kerf.UserCases.csproj" />
    <!-- The check as it was and the comparison with it (the check on small shapes): KERF_CHECK_COMPARE=file -->
    <Compile Include="..\..\..\kernel\tests\Shared\FullCheck\*.cs" Link="Shared\FullCheck\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\kernel\tests\Shared\BooleanIssueShapes.cs" Link="Shared\BooleanIssueShapes.cs" />
    <!-- The kernel's refusals of an argument, where a test calls the kernel itself (decision 2028) -->
    <Compile Include="..\..\..\kernel\tests\Shared\KernelAssert.cs" Link="Shared\KernelAssert.cs" />
    <!-- The public surface as text, and what in it could change (unit 13P): PublicApiBaselineTests, ImmutabilityGuardTests -->
    <Compile Include="..\..\..\kernel\tests\Shared\ApiSurface.cs" Link="Shared\ApiSurface.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Two of the kernel's test fonts (kernel/tests/Kerf.Kernel.ModelingAlgorithms.Tests/Fonts/Data), for Text (unit 13E) -->
    <EmbeddedResource Include="Objects\Fonts\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
    <!-- OCCT #1570's part (kernel/tests/Kerf.Kernel.ModelingAlgorithms.Tests/BRepFilletAPI/Issues), for FilletCrossingTests (unit 15L) -->
    <EmbeddedResource Include="Topology\Issues\*.brep" LogicalName="Topology.Issues.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>