<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The assembly and its namespaces keep Kerf.Modeling's test names: xUnit orders the tests by IDs made from them, and
         the differential run's native log (retired in unit 10Q) was recorded in that order, which decides which test
         logs a shape the tests share (unit 10E) -->
    <AssemblyName>Kerf.Modeling.Tests</AssemblyName>
    <RootNamespace>Kerf.Modeling.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Reference\**" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\..\..\kernel\tests\Shared\NativeStepText.cs" Link="Shared\NativeStepText.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Kerf.Tests.Shared" />
    <Using Include="Kerf.Topology" />
    <Using Include="Kerf.Geometry" />
    <Using Include="Kerf.Color" Alias="Color" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kerf.Modeling\Kerf.Modeling.csproj" />
    <!-- The check as it was and the comparison with it (the check on small shapes): KERF_CHECK_COMPARE=file -->
    <Compile Include="..\..\..\kernel\tests\Shared\FullCheck\*.cs" Link="Shared\FullCheck\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\kernel\tests\Shared\BooleanIssueShapes.cs" Link="Shared\BooleanIssueShapes.cs" />
  </ItemGroup>
</Project>