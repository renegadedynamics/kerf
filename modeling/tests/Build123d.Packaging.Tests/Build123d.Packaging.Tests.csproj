<Project Sdk="Microsoft.NET.Sdk">

  <!-- Run by tools/pack.ps1 after packing: it loads the packages, not the projects, so it references neither -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- The host's copy, which the extension shares, as Bento's does -->
    <PackageReference Include="Bento.Collections" Version="0.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
