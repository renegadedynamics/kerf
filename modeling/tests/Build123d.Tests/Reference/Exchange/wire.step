#12 = CARTESIAN_POINT('',(0.,0.,0.));
#13 = DIRECTION('',(0.,0.,1.));
#14 = DIRECTION('',(1.,0.,-0.));
#15 = GEOMETRIC_CURVE_SET('',(#16,#23,#30));
#16 = TRIMMED_CURVE('',#17,(#21,PARAMETER_VALUE(0.)),(#22,
    PARAMETER_VALUE(10.)),.T.,.PARAMETER.);
#17 = LINE('',#18,#19);
#18 = CARTESIAN_POINT('',(0.,0.,0.));
#19 = VECTOR('',#20,1.);
#20 = DIRECTION('',(1.,0.,0.));
#21 = CARTESIAN_POINT('',(0.,0.,0.));
#22 = CARTESIAN_POINT('',(10.,0.,0.));
#23 = TRIMMED_CURVE('',#24,(#28,PARAMETER_VALUE(0.)),(#29,
    PARAMETER_VALUE(5.)),.T.,.PARAMETER.);
#24 = LINE('',#25,#26);
#25 = CARTESIAN_POINT('',(10.,0.,0.));
#26 = VECTOR('',#27,1.);
#27 = DIRECTION('',(0.,1.,0.));
#28 = CARTESIAN_POINT('',(10.,0.,0.));
#29 = CARTESIAN_POINT('',(10.,5.,0.));
#30 = TRIMMED_CURVE('',#31,(#35,PARAMETER_VALUE(0.)),(#36,
    PARAMETER_VALUE(7.615773105864)),.T.,.PARAMETER.);
#31 = LINE('',#32,#33);
#32 = CARTESIAN_POINT('',(10.,5.,0.));
#33 = VECTOR('',#34,1.);
#34 = DIRECTION('',(-0.919145030018,0.393919298579,0.));
#35 = CARTESIAN_POINT('',(10.,5.,0.));
#36 = CARTESIAN_POINT('',(3.,8.,0.));
#37 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) 
GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#41)) GLOBAL_UNIT_ASSIGNED_CONTEXT(
(#38,#39,#40)) REPRESENTATION_CONTEXT('Context #1',
  '3D Context with UNIT and UNCERTAINTY') );
#38 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#39 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#40 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#41 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#38,
