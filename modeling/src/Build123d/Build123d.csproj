<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Build123d</RootNamespace>
    <Description>A .NET port of build123d, a code-first CAD library built on OpenCascade.</Description>
    <!-- The public API is documented -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Build123d.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Build123d.OcctNet\Build123d.OcctNet.csproj" />
    <PackageReference Include="Schematiq.Collections" Version="1.0.0-beta.1" />
  </ItemGroup>

</Project>
