<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build123d.Occt's public API over OCCT.NET, the managed port of OCCT: the same namespace, types and members, so
    Build123d compiles unchanged against either (Build123dBackend=OcctNet). No native libraries. Generated by
    tools/OcctNetGen from Build123d.Occt's API (tools/generate-occtnet.ps1); the runtime is hand-written.
  -->
  <PropertyGroup>
    <RootNamespace>Build123d.Occt</RootNamespace>
    <Description>Build123d.Occt's API over OCCT.NET, the managed port of OpenCascade: no native libraries.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The wrappers keep OCCT's names (gp_Pnt, BRepAlgoAPI_Cut, ...) and are not documented -->
    <NoWarn>$(NoWarn);CS1591;CS8981;IDE1006</NoWarn>
  </PropertyGroup>

  <!-- Shared with the native binding: the enums, the operation context and the exchange types have no native code -->
  <ItemGroup>
    <Compile Include="..\Build123d.Occt\Generated\Enums.g.cs" Link="Shared\Enums.g.cs" />
    <Compile Include="..\Build123d.Occt\Runtime\OcctContext.cs" Link="Shared\OcctContext.cs" />
    <Compile Include="..\Build123d.Occt\Runtime\Exchange.cs" Link="Shared\Exchange.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(OcctNetRoot)src/OcctNet.DataExchange/OcctNet.DataExchange.csproj" />
  </ItemGroup>

  <Target Name="RequireOcctNet" BeforeTargets="ResolveProjectReferences"
          Condition="!Exists('$(OcctNetRoot)src/OcctNet.DataExchange/OcctNet.DataExchange.csproj')">
    <Error Text="OCCT.NET not found at '$(OcctNetRoot)': pass -p:OcctNetRoot=&lt;OCCT.NET checkout&gt;/" />
  </Target>

</Project>
