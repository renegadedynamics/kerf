<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The native binding's API (Build123d.Occt, retired in unit 10B) over OCCT.NET, the managed port of OCCT. No native
    libraries. Generated by tools/OcctNetGen; the runtime is hand-written.
  -->
  <PropertyGroup>
    <RootNamespace>Build123d.Occt</RootNamespace>
    <Description>Build123d.Occt's API over OCCT.NET, the managed port of OpenCascade: no native libraries.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The wrappers keep OCCT's names (gp_Pnt, BRepAlgoAPI_Cut, ...) and are not documented -->
    <NoWarn>$(NoWarn);CS1591;CS8981;IDE1006</NoWarn>
  </PropertyGroup>

  <!--
    OCCT.NET: the packages on nuget.org by default; with OcctNetRoot given, that checkout's projects, which pack as the
    same package dependencies (OCCT.NET's pack-nuget.ps1 packs this way)
  -->
  <ItemGroup Condition="'$(OcctNetRoot)' == ''">
    <PackageReference Include="OcctNet.Foundation" Version="$(OcctNetVersion)" />
    <PackageReference Include="OcctNet.ModelingData" Version="$(OcctNetVersion)" />
    <PackageReference Include="OcctNet.ModelingAlgorithms" Version="$(OcctNetVersion)" />
    <PackageReference Include="OcctNet.DataExchange" Version="$(OcctNetVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(OcctNetRoot)' != ''">
    <ProjectReference Include="$(OcctNetRoot)src/OcctNet.DataExchange/OcctNet.DataExchange.csproj" />
  </ItemGroup>

  <Target Name="RequireOcctNet" BeforeTargets="ResolveProjectReferences"
          Condition="'$(OcctNetRoot)' != '' And !Exists('$(OcctNetRoot)src/OcctNet.DataExchange/OcctNet.DataExchange.csproj')">
    <Error Text="OCCT.NET not found at OcctNetRoot '$(OcctNetRoot)': pass an OCCT.NET checkout, or no OcctNetRoot for the packages" />
  </Target>

</Project>
