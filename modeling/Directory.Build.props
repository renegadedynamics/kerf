<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .NET naming (IDE1006, the root .editorconfig), enforced since unit 10E -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>

  <!--
    Kerf.Modeling builds on the kernel's projects in the repository's kernel folder (KerfKernelRoot, ../kernel/ by
    default), which pack as the Kerf.Kernel.* package dependencies.
  -->
  <PropertyGroup>
    <KerfKernelRoot Condition="'$(KerfKernelRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RepoRoot)../kernel/'))</KerfKernelRoot>
    <KerfKernelRoot>$([MSBuild]::EnsureTrailingSlash('$(KerfKernelRoot)'))</KerfKernelRoot>
  </PropertyGroup>

  <!--
    What ReadyToRun compiles (unit 11C, docs/performance.md): the framework's code may be inlined into Kerf's, each piece
    guarded at load by a check of its IL. Not non-local generics: they'd save more of what the JIT would otherwise compile, but
    another copy of Kerf in the process, compiled by the JIT, then fails (decision 1890). This is
    most of what the JIT would otherwise compile on opening. About 21% larger on disk than plain ReadyToRun; opening
    falls by about 30%. Used only when publishing ReadyToRun, as tools/pack-nuget.ps1 and tools/bench.ps1 do.
  -->
  <PropertyGroup>
    <PublishReadyToRunCrossgen2ExtraArgs>--opt-cross-module:*;--Ot</PublishReadyToRunCrossgen2ExtraArgs>
  </PropertyGroup>

  <!-- Packages: SemVer, with the changes in CHANGELOG.md -->
  <PropertyGroup>
    <VersionPrefix>0.6.0</VersionPrefix>
    <Authors>Kerf contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 The Kerf contributors; derived from build123d, copyright (c) 2022–2025 The build123d Contributors</Copyright>
    <PackageProjectUrl>https://github.com/renegadedynamics/kerf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/renegadedynamics/kerf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(RepoRoot)README.md;$(RepoRoot)NOTICE;$(RepoRoot)THIRD-PARTY-NOTICES.md;$(RepoRoot)CHANGELOG.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(RepoRoot)licenses/*" Pack="true" PackagePath="licenses/" Visible="false" />
  </ItemGroup>
</Project>
