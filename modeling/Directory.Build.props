<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>

  <!--
    build123d.NET calls OCCT.NET, the managed port of OCCT, directly (unit 10B), from the kernel's projects in the
    repository's kernel folder (KerfKernelRoot, ../kernel/ by default), which pack as the Kerf.Kernel.* package dependencies.
    It uses kernel members the published packages (0.1.0-preview.3) don't make public, so it no longer builds against
    them (UseOcctNetPackages is gone).
  -->
  <PropertyGroup>
    <KerfKernelRoot Condition="'$(KerfKernelRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RepoRoot)../kernel/'))</KerfKernelRoot>
    <KerfKernelRoot>$([MSBuild]::EnsureTrailingSlash('$(KerfKernelRoot)'))</KerfKernelRoot>
  </PropertyGroup>

  <!-- Packages: SemVer, with the changes in CHANGELOG.md -->
  <PropertyGroup>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>Kerf contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 The build123d.NET Contributors; based on build123d, copyright (c) 2022–2025 The build123d Contributors</Copyright>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(RepoRoot)README.md;$(RepoRoot)NOTICE;$(RepoRoot)THIRD-PARTY-NOTICES.md;$(RepoRoot)CHANGELOG.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(RepoRoot)licenses/*" Pack="true" PackagePath="licenses/" Visible="false" />
  </ItemGroup>
</Project>
