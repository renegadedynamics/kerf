<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>

  <!--
    build123d.NET's API over OCCT.NET, the managed port of OCCT (src/Build123d.OcctNet): from the kernel's projects in
    the repository's kernel folder (OcctNetRoot, ../kernel/ by default), or, with -p:UseOcctNetPackages=true, from the
    OcctNet.* packages on nuget.org at OcctNetVersion.
  -->
  <PropertyGroup>
    <OcctNetVersion Condition="'$(OcctNetVersion)' == ''">0.1.0-preview.3</OcctNetVersion>
    <!-- The kernel's projects, beside this folder in the Kerf repository; -p:UseOcctNetPackages=true builds against
         the published packages instead -->
    <OcctNetRoot Condition="'$(OcctNetRoot)' == '' and '$(UseOcctNetPackages)' != 'true' and Exists('$(RepoRoot)../kernel/src')">$([System.IO.Path]::GetFullPath('$(RepoRoot)../kernel/'))</OcctNetRoot>
    <OcctNetRoot Condition="'$(OcctNetRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$(OcctNetRoot)'))</OcctNetRoot>
  </PropertyGroup>

  <!-- Packages: SemVer, with the changes in CHANGELOG.md -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>build123d.NET contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 The build123d.NET Contributors; based on build123d, copyright (c) 2022–2025 The build123d Contributors</Copyright>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(RepoRoot)README.md;$(RepoRoot)NOTICE;$(RepoRoot)THIRD-PARTY-NOTICES.md;$(RepoRoot)CHANGELOG.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(RepoRoot)licenses/*" Pack="true" PackagePath="licenses/" Visible="false" />
  </ItemGroup>
</Project>
