<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- Runtime whose native build (OCCT + shim) local builds and tests use -->
    <NativeRid Condition="'$(NativeRid)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</NativeRid>
  </PropertyGroup>

  <!--
    The OCCT backend. OcctNet (the default) builds build123d.NET's API over OCCT.NET, the managed port of OCCT
    (src/Build123d.OcctNet): from the OcctNet.* packages on nuget.org at OcctNetVersion, or, with OcctNetRoot given,
    from that OCCT.NET checkout's projects (for working on both together, and for OCCT.NET's pack-nuget.ps1). Native
    binds native OCCT through the b3docct shim (src/Build123d.Occt), opt-in with -p:Build123dBackend=Native: it is the
    reference OCCT.NET's oracle compares against, and is no longer published. Build123d compiles unchanged against
    either.
  -->
  <PropertyGroup>
    <Build123dBackend Condition="'$(Build123dBackend)' == ''">OcctNet</Build123dBackend>
    <OcctNetVersion Condition="'$(OcctNetVersion)' == ''">0.1.0-preview.3</OcctNetVersion>
    <OcctNetRoot Condition="'$(OcctNetRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$(OcctNetRoot)'))</OcctNetRoot>
    <!-- The checkout whose native build (.deps/install, native/out) the native backend uses: this one by default -->
    <Build123dNativeRoot Condition="'$(Build123dNativeRoot)' == ''">$(RepoRoot)</Build123dNativeRoot>
    <Build123dNativeRoot>$([MSBuild]::EnsureTrailingSlash('$(Build123dNativeRoot)'))</Build123dNativeRoot>
    <!--
      Each backend builds into folders of its own, so the two sit side by side: the default into bin and obj, Native
      into bin-native and obj-native. bin-occtnet and obj-occtnet are where OcctNet built before it became the default.
    -->
    <BaseOutputPath Condition="'$(Build123dBackend)' == 'Native'">bin-native\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(Build123dBackend)' == 'Native'">obj-native\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;bin-native/**;obj-native/**;bin-occtnet/**;obj-occtnet/**</DefaultItemExcludes>
    <DefineConstants Condition="'$(Build123dBackend)' == 'OcctNet'">$(DefineConstants);OCCTNET</DefineConstants>
  </PropertyGroup>

  <!-- Packages: SemVer, with the changes in CHANGELOG.md -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>build123d.NET contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 The build123d.NET Contributors; based on build123d, copyright (c) 2022–2025 The build123d Contributors</Copyright>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(RepoRoot)README.md;$(RepoRoot)NOTICE;$(RepoRoot)THIRD-PARTY-NOTICES.md;$(RepoRoot)CHANGELOG.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(RepoRoot)licenses/*" Pack="true" PackagePath="licenses/" Visible="false" />
  </ItemGroup>
</Project>
