<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .NET naming (IDE1006, the root .editorconfig), enforced since unit 10E -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>

  <!--
    Kerf.Modeling builds on the kernel's projects in the repository's kernel folder (KerfKernelRoot, ../kernel/ by
    default), which pack as the Kerf.Kernel.* package dependencies.
  -->
  <PropertyGroup>
    <KerfKernelRoot Condition="'$(KerfKernelRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RepoRoot)../kernel/'))</KerfKernelRoot>
    <KerfKernelRoot>$([MSBuild]::EnsureTrailingSlash('$(KerfKernelRoot)'))</KerfKernelRoot>
  </PropertyGroup>

  <!-- Packages: SemVer, with the changes in CHANGELOG.md -->
  <PropertyGroup>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>Kerf contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 The Kerf contributors; derived from build123d, copyright (c) 2022–2025 The build123d Contributors</Copyright>
    <PackageProjectUrl>https://github.com/renegadedynamics/kerf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/renegadedynamics/kerf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(RepoRoot)README.md;$(RepoRoot)NOTICE;$(RepoRoot)THIRD-PARTY-NOTICES.md;$(RepoRoot)CHANGELOG.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(RepoRoot)licenses/*" Pack="true" PackagePath="licenses/" Visible="false" />
  </ItemGroup>
</Project>
