<Project>
  <!--
    The solution restores by the project graph, as each project does (kernel/Directory.Build.props): the modeling
    layer's projects, which the kernel's oracle tests build on their native backend, restore with those properties
  -->
  <PropertyGroup>
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
  </PropertyGroup>
</Project>
