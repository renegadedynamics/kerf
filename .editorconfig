# Kerf: .NET naming for the kernel and the modelling layer (kernel/docs/design-rules.md, section 1).
#
# IDE1006 is an error in the build (EnforceCodeStyleInBuild, set in kernel/ and modeling/Directory.Build.props) since
# unit 10E applied the name map. The sections at the end turn it off where OCCT's names stay or the code doesn't obey the
# rules yet; each later unit that renames a folder removes it from the list (design-rules.md, "Turning the rules on").

root = true

[*]
indent_style = space
charset = utf-8
insert_final_newline = true

[*.cs]
indent_size = 4

# Reported by the build (EnforceCodeStyleInBuild), as an error. The rules' own severities below don't matter to the build:
# this one does
dotnet_diagnostic.IDE1006.severity = error

# Symbol groups

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameters.applicable_accessibilities = *

dotnet_naming_symbols.members.applicable_kinds = method, property, event, local_function, namespace
dotnet_naming_symbols.members.applicable_accessibilities = *

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_symbols.visible_fields.applicable_kinds = field
dotnet_naming_symbols.visible_fields.applicable_accessibilities = public

dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private, internal, protected, protected_internal, private_protected
dotnet_naming_symbols.private_static_fields.required_modifiers = static

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal, protected, protected_internal, private_protected

dotnet_naming_symbols.variables.applicable_kinds = parameter, local
dotnet_naming_symbols.variables.applicable_accessibilities = *

# Styles

dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_style.interface.capitalization = pascal_case
dotnet_naming_style.interface.required_prefix = I

dotnet_naming_style.type_parameter.capitalization = pascal_case
dotnet_naming_style.type_parameter.required_prefix = T

dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_style.s_camel.capitalization = camel_case
dotnet_naming_style.s_camel.required_prefix = s_

dotnet_naming_style.camel.capitalization = camel_case

# Rules: the first that matches a symbol applies, in this order

dotnet_naming_rule.interfaces.symbols = interfaces
dotnet_naming_rule.interfaces.style = interface
dotnet_naming_rule.interfaces.severity = warning

dotnet_naming_rule.types.symbols = types
dotnet_naming_rule.types.style = pascal
dotnet_naming_rule.types.severity = warning

dotnet_naming_rule.type_parameters.symbols = type_parameters
dotnet_naming_rule.type_parameters.style = type_parameter
dotnet_naming_rule.type_parameters.severity = warning

dotnet_naming_rule.members.symbols = members
dotnet_naming_rule.members.style = pascal
dotnet_naming_rule.members.severity = warning

# Constants, enum members included, and static read-only fields: PascalCase
dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal
dotnet_naming_rule.constants.severity = warning

dotnet_naming_rule.static_readonly_fields.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields.style = pascal
dotnet_naming_rule.static_readonly_fields.severity = warning

# Public fields: PascalCase (and, by design-rules.md, read-only). Protected fields are the engine's inherited state
# (OCCT's myX in base classes): _camelCase like private ones
dotnet_naming_rule.visible_fields.symbols = visible_fields
dotnet_naming_rule.visible_fields.style = pascal
dotnet_naming_rule.visible_fields.severity = warning

dotnet_naming_rule.private_static_fields.symbols = private_static_fields
dotnet_naming_rule.private_static_fields.style = s_camel
dotnet_naming_rule.private_static_fields.severity = warning

dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning

dotnet_naming_rule.variables.symbols = variables
dotnet_naming_rule.variables.style = camel
dotnet_naming_rule.variables.severity = warning

# OCCT's names, kept on purpose (said narrowly):
# - the types unit 10J replaces keep their OCCT names in the namespace Occt (decision 1349, 58): NCollection, TCollection
#   and PackedList;
# - AdvApp2Var's numeric core is f2c's translation of OCCT's Fortran (decisions 77 and 902): its commons, routines and
#   locals keep Fortran's names, which its comments and OCCT's sources use.
[{kernel/src/Kerf.Kernel.Foundation/NCollection/**,kernel/src/Kerf.Kernel.Foundation/TCollection/**,kernel/src/Kerf.Kernel.Foundation/Collections/PackedList*.cs,kernel/src/Kerf.Kernel.ModelingData/AdvApp2Var/**}]
dotnet_diagnostic.IDE1006.severity = none

# Tests, Draw-lite, benchmarks, samples and tools: the rename (10E) renamed the kernel's symbols wherever they are used,
# not these projects' own (their test names, OCCT's Draw commands and the recordings' helpers keep their style)
[{kernel/tests/**,kernel/benchmarks/**,kernel/samples/**,kernel/tools/**,modeling/tests/**}]
dotnet_diagnostic.IDE1006.severity = none

# Not yet obeying (unit 10E's measurement, 3,337 violations in these folders): mostly parameters and locals the renamer
# left as they were because the .NET name was taken in the same body (thePoint beside a local point; decision 15304),
# then type parameters (TheCurve), fields whose name was taken, local functions and constants. Each later unit that
# touches a folder renames them and removes it here.
[kernel/src/Kerf.Kernel.DataExchange/{RWStepBasic/**,RWStepGeom/**,STEPCAFControl/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.DataExchange/{STEPConstruct/**,STEPControl/**,STEPSelections/**,StepToTopoDS/**,TopoDSToStep/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.Foundation/{BSplCLib/**,BSplSLib/**,Bnd/**,Convert/**,ElSLib/**,MathInteg/**,MathOpt/**,MathRoot/**,MathSys/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.Foundation/{MathUtils/**,PLib/**,Poly/**,Standard/**,gp/**,math/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.ModelingAlgorithms/{AppBlend/**,ApproxInt/**,BOPAlgo/**,BOPTools/**,BRepAlgo/**,BRepBlend/**,BRepBuilderAPI/**,BRepCheck/**,BRepClass3d/**,BRepExtrema/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.ModelingAlgorithms/{BRepFeat/**,BRepFill/**,BRepFilletAPI/**,BRepGProp/**,BRepLib/**,BRepMesh/**,BRepOffset/**,BRepOffsetAPI/**,BRepPrimAPI/**,BRepSweep/**,BRepTopAdaptor/**,BiTgte/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.ModelingAlgorithms/{BlendFunc/**,ChFi2d/**,ChFi3d/**,ChFiDS/**,ChFiKPart/**,Contap/**,Draft/**,FairCurve/**,FilletSurf/**,GccAna/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.ModelingAlgorithms/{Geom2dGcc/**,Geom2dHatch/**,GeomFill/**,GeomInt/**,GeomPlate/**,HLRBRep/**,HLRTopoBRep/**,IntCurve/**,IntCurveSurface/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.ModelingAlgorithms/{IntImp/**,IntImpParGen/**,IntPatch/**,IntPolyh/**,IntStart/**,IntSurf/**,IntTools/**,IntWalk/**,Intf/**,Law/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.ModelingAlgorithms/{LocOpe/**,Plate/**,ShapeAnalysis/**,ShapeBuild/**,ShapeConstruct/**,ShapeCustom/**,ShapeExtend/**,ShapeFix/**,ShapeProcess/**,ShapeUpgrade/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.ModelingAlgorithms/{TopClass/**,TopOpeBRepBuild/**,TopOpeBRepDS/**,TopOpeBRepTool/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.ModelingData/{AdvApprox/**,AppDef/**,AppParCurves/**,Approx/**,BRep/**,BRepAdaptor/**,BRepLProp/**,BRepTools/**,BinTools/**,BndLib/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.ModelingData/{Extrema/**,FEmTool/**,GC/**,GProp/**,Geom/**,Geom2d/**,Geom2dAdaptor/**,Geom2dConvert/**,GeomAdaptor/**,GeomBndLib/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.ModelingData/{GeomConvert/**,GeomGridEval/**,GeomLib/**,GeomTools/**,Hermit/**,IntAna/**,IntAna2d/**,ProjLib/**,TopTools/**}]
dotnet_diagnostic.IDE1006.severity = none

[kernel/src/Kerf.Kernel.ModelingData/gce/**]
dotnet_diagnostic.IDE1006.severity = none

# Dead code stays out of the libraries (kernel/docs/clean-up.md): private members nothing uses or only writes, and usings nothing needs
[{kernel/src/**,modeling/src/**}]
dotnet_diagnostic.IDE0051.severity = error
dotnet_diagnostic.IDE0052.severity = error
dotnet_diagnostic.CA1823.severity = error
dotnet_diagnostic.IDE0005.severity = error
