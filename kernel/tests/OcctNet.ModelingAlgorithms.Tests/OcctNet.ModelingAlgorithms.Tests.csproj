<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OcctNet.ModelingAlgorithms.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OcctNet.ModelingAlgorithms\OcctNet.ModelingAlgorithms.csproj" />
    <ProjectReference Include="..\..\src\OcctNet.Analyzers\OcctNet.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- OCCT's source (tools/get-occt.ps1), for the .brep files of its test data -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OcctSourceDir</_Parameter1>
      <_Parameter2>$(OcctSourceDir)</_Parameter2>
    </AssemblyAttribute>
    <!-- OCCT's test dataset (tools/get-occt-testdata.ps1), for ShapeFix's tests on the heal group's inputs -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OcctTestDataDir</_Parameter1>
      <_Parameter2>$(OcctTestDataDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- BRep_Builder shapes for the topology tests (boxes until BRepPrimAPI, unit 3M), shared with the ModelingData tests -->
    <Compile Include="..\OcctNet.ModelingData.Tests\TopoDS\TestShapes.cs" Link="TestShapes.cs" />
    <!-- A record of a shape graph, to check that the in-place statics' twins leave their inputs unchanged -->
    <Compile Include="..\OcctNet.ModelingData.Tests\TopoDS\ShapeSnapshot.cs" Link="ShapeSnapshot.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native OCCT's walking lines and their approximations, recorded once (unit 5F, decision 680) -->
    <EmbeddedResource Include="ApproxInt\ApproxIntRecordings.txt.gz" LogicalName="ApproxIntRecordings.txt.gz" />
    <!-- Native OCCT's walking steps, recorded by tools/walkrec (decision 687) -->
    <EmbeddedResource Include="IntWalk\Recordings\*.txt" LogicalName="IntWalk.Recordings.%(Filename)%(Extension)" />
    <!-- Native OCCT's parametric intersections step by step, recorded by tools/walkrec (unit 5D) -->
    <EmbeddedResource Include="IntPatch\Recordings\*.txt" LogicalName="IntPatch.Recordings.%(Filename)%(Extension)" />
    <!-- Native OCCT's edge intersectors on data/occ shapes, recorded by tools/edgerec (unit 6C, decision 754) -->
    <EmbeddedResource Include="IntTools\Recordings\edgerec.txt.gz" LogicalName="IntTools.edgerec.txt.gz" />
    <!-- Native OCCT's face/face intersections, recorded by tools/ffrec (unit 6D) -->
    <EmbeddedResource Include="IntTools\FaceFaceRecordings.txt.gz" LogicalName="IntTools.FaceFaceRecordings.txt.gz" />
    <!-- Native OCCT's analytic constraint solvers on random configurations, recorded by tools/gccrec (unit 5K1) -->
    <EmbeddedResource Include="GccAna\Recordings\gccrec.txt.gz" LogicalName="GccAna.gccrec.txt.gz" />
    <EmbeddedResource Include="BOPAlgo\PaveFillerRecordings.txt.gz" LogicalName="BOPAlgo.PaveFillerRecordings.txt.gz" />
    <!-- Native OCCT's faces from wires (BRepAlgo_FaceRestrictor, TopOpeBRepBuild_WireToFace), recorded by tools/frrec (unit 5O1) -->
    <EmbeddedResource Include="BRepAlgo\FaceRestrictorRecordings.txt.gz" LogicalName="BRepAlgo.FaceRestrictorRecordings.txt.gz" />
    <!-- Native OCCT's bisectors (Bisector_Bisec, Bisector_Inter), recorded by tools/bisrec (unit 5M) -->
    <EmbeddedResource Include="Bisector\Recordings\bisrec.txt.gz" LogicalName="Bisector.bisrec.txt.gz" />
    <!-- Native OCCT's bisecting loci of planar faces (BRepMAT2d, MAT2d, MAT), recorded by tools/matrec (unit 5M) -->
    <EmbeddedResource Include="BRepMAT2d\Recordings\matrec.txt.gz" LogicalName="BRepMAT2d.matrec.txt.gz" />
    <!-- Native OCCT's sweep surfaces, laws and package functions, recorded by tools/sweeprec (unit 5L2) -->
    <EmbeddedResource Include="GeomFill\Recordings\sweeprec.txt.gz" LogicalName="GeomFill.sweeprec.txt.gz" />
    <!-- Native OCCT's BRepFill_CompatibleWires, recorded by tools/cwrec (unit 5S1) -->
    <EmbeddedResource Include="BRepFill\Recordings\cwrec.txt.gz" LogicalName="BRepFill.cwrec.txt.gz" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Occt.Standard" Static="true" />
  </ItemGroup>

</Project>
