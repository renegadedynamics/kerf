<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\OcctNet.Foundation\OcctNet.Foundation.csproj" />
    <!-- Runs on this project as on the ported code, and the analyzer's own tests compile snippets against it -->
    <ProjectReference Include="..\..\src\OcctNet.Analyzers\OcctNet.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- OCCT's math_Vector and math_IntegerVector are using aliases of math_VectorBase<T>; so are these -->
    <Using Include="Occt.math_VectorBase&lt;double&gt;" Alias="math_Vector" />
    <Using Include="Occt.math_VectorBase&lt;int&gt;" Alias="math_IntegerVector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Occt.Standard" Static="true" />
  </ItemGroup>

</Project>
