<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' != 'false'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <Using Include="Kerf.Engine" />
    <Using Include="Kerf.Engine.Numerics.VectorBase&lt;double&gt;" Alias="math_Vector" />
    <Using Include="Kerf.Engine.Numerics.VectorBase&lt;int&gt;" Alias="math_IntegerVector" />
  </ItemGroup>
  <!-- The engine's failures, thrown or held by the exception a public member refuses with (unit 10P2) -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Kerf.Kernel.Foundation.Tests' Or '$(MSBuildProjectName)' == 'Kerf.Kernel.ModelingData.Tests' Or '$(MSBuildProjectName)' == 'Kerf.Kernel.ModelingAlgorithms.Tests' Or '$(MSBuildProjectName)' == 'Kerf.Kernel.DataExchange.Tests' Or '$(MSBuildProjectName)' == 'Kerf.Kernel.Oracle.Tests' Or '$(MSBuildProjectName)' == 'Kerf.Kernel.DrawLite.Tests'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/EngineAssert.cs" Link="Shared/EngineAssert.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/NativeStepText.cs" Link="Shared/NativeStepText.cs" />
  </ItemGroup>
  <!-- The check as it was and the comparison with it (the check on small shapes): KERF_CHECK_COMPARE=file -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Kerf.Kernel.ModelingAlgorithms.Tests' Or '$(MSBuildProjectName)' == 'Kerf.Kernel.DrawLite'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/FullCheck/*.cs" Link="Shared/FullCheck/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
