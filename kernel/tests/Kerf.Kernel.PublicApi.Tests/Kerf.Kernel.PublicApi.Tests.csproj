<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The public API's tests (unit 10L1), written as a user calls it: this assembly has no InternalsVisibleTo from the
    kernel, so a test that reaches for the engine doesn't compile. Since 10L2 it also reaches
    ModelingAlgorithms' public operations (geometry's, construction, Booleans, fillets, offsets and features).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kerf.Kernel.Foundation\Kerf.Kernel.Foundation.csproj" />
    <ProjectReference Include="..\..\src\Kerf.Kernel.ModelingData\Kerf.Kernel.ModelingData.csproj" />
    <!-- Measurement, healing, meshing and exchange (unit 10L3) -->
    <ProjectReference Include="..\..\src\Kerf.Kernel.ModelingAlgorithms\Kerf.Kernel.ModelingAlgorithms.csproj" />
    <ProjectReference Include="..\..\src\Kerf.Kernel.DataExchange\Kerf.Kernel.DataExchange.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unit 10L3's shapes, read with the public BREP reader -->
    <EmbeddedResource Include="Fixtures\*.brep" LogicalName="Fixtures.%(Filename).brep" />
    <!-- Unit 10L4's golden pictures -->
    <EmbeddedResource Include="Fixtures\*.png" LogicalName="Fixtures.%(Filename).png" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="Occt" />
    <Using Remove="Kerf.Engine.Numerics.VectorBase&lt;double&gt;" />
    <Using Remove="Kerf.Engine.Numerics.VectorBase&lt;int&gt;" />
  </ItemGroup>

</Project>
