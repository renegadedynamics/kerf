<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The engine's benchmarks: meshing and the viewer's extraction, Booleans, construction, features, STEP and healing.
    In Kerf.slnx since unit 11A, so the merge gate builds them. tools/bench.ps1 runs the fixed set; to run one suite by
    hand, Program.cs has the command line.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <ProjectReference Include="..\..\src\Kerf.Kernel.ModelingAlgorithms\Kerf.Kernel.ModelingAlgorithms.csproj" />
    <Compile Include="..\BenchRows.cs" Link="BenchRows.cs" />
    <Compile Include="..\Kerf.Kernel.Bento.Benchmarks\HeapWalk.cs" Link="HeapWalk.cs" />
    <!-- The STEP parser's suite (unit 8P) -->
    <ProjectReference Include="..\..\src\Kerf.Kernel.DataExchange\Kerf.Kernel.DataExchange.csproj" />
    <!-- The WebAssembly demo's work, to compare its buffers with win-x64's -->
    <Compile Include="..\..\samples\Kerf.Kernel.WasmDemo\DemoCore.cs" Link="DemoCore.cs" />
    <!-- The corpus's bopfuse_simple arguments (tools/pfrec's recording, decision 785) -->
    <EmbeddedResource Include="..\..\tests\Kerf.Kernel.ModelingAlgorithms.Tests\BOPAlgo\PaveFillerRecordings.txt.gz" LogicalName="BOPAlgo.PaveFillerRecordings.txt.gz" Link="PaveFillerRecordings.txt.gz" />
    <!-- OCCT's source (tools/get-occt.ps1), for data/occ -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OcctSourceDir</_Parameter1>
      <_Parameter2>$(OcctSourceDir)</_Parameter2>
    </AssemblyAttribute>
    <!-- OCCT's test dataset (tools/get-occt-testdata.ps1), for the corpus's complex Boolean grids -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OcctTestDataDir</_Parameter1>
      <_Parameter2>$(OcctTestDataDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
