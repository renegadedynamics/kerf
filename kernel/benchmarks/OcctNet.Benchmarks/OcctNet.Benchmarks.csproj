<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 4's benchmarks (phase4-plan section 2.5): meshing and the viewer's extraction, and phase 6's Booleans (unit
    6M). They timed the port against native OCCT until unit 10B retired it; now the port alone is timed. Run it in
    Release with the argument "quick" (a Stopwatch table) or "bdn" (BenchmarkDotNet, in process, with its own arguments
    after it); see Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <ProjectReference Include="..\..\src\OcctNet.ModelingAlgorithms\OcctNet.ModelingAlgorithms.csproj" />
    <!-- The STEP parser's suite (unit 8P) -->
    <ProjectReference Include="..\..\src\OcctNet.DataExchange\OcctNet.DataExchange.csproj" />
    <!-- The WebAssembly demo's work, to compare its buffers with win-x64's -->
    <Compile Include="..\..\samples\OcctNet.WasmDemo\DemoCore.cs" Link="DemoCore.cs" />
    <!-- The corpus's bopfuse_simple arguments (tools/pfrec's recording, decision 785) -->
    <EmbeddedResource Include="..\..\tests\OcctNet.ModelingAlgorithms.Tests\BOPAlgo\PaveFillerRecordings.txt.gz" LogicalName="BOPAlgo.PaveFillerRecordings.txt.gz" Link="PaveFillerRecordings.txt.gz" />
    <!-- OCCT's source (tools/get-occt.ps1), for data/occ -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OcctSourceDir</_Parameter1>
      <_Parameter2>$(OcctSourceDir)</_Parameter2>
    </AssemblyAttribute>
    <!-- OCCT's test dataset (tools/get-occt-testdata.ps1), for the corpus's complex Boolean grids -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OcctTestDataDir</_Parameter1>
      <_Parameter2>$(OcctTestDataDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
