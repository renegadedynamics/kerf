<Project Sdk="Microsoft.NET.Sdk">

  <!--
    tools/kerf-rename: renames the kernel, its tests and the modelling layer to .NET conventions from a reviewed name
    map (docs/design-rules.md, docs/phase10-plan.md section 2.3). See README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>kerf-rename</AssemblyName>
    <RootNamespace>Kerf.Tools.Rename</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The tool follows .NET's naming rules, not OCCT's -->
    <NoWarn>$(NoWarn.Replace('IDE1006', ''))</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" />
  </ItemGroup>

</Project>
