<Project Sdk="Microsoft.NET.Sdk">

  <!-- tools/stepgen: generates the STEP entity classes and their readers and writers from OCCT's C++ -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- C# written by hand that the generator copies into its output: not the generator's own code -->
    <Compile Remove="overrides/**" />
    <None Include="overrides/**" />
  </ItemGroup>

</Project>
