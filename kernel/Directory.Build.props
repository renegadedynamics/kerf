<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- .NET naming (IDE1006, the root .editorconfig) is enforced since unit 10E; the code OCCT's names must survive in
         is listed there. CS8981 (a lower-case type name): the f2c commons of AdvApp2Var keep theirs -->
    <NoWarn>$(NoWarn);CS8981</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The OCCT source this port follows (occt-version.json); tools/get-occt.ps1 fetches it here -->
    <OcctSourceDir>$(RepoRoot).deps/occt-src/</OcctSourceDir>
    <!-- OCCT's test data (tools/get-occt-testdata.ps1), which the Draw corpus restores: CSF_TestDataPath in OCCT -->
    <OcctTestDataDir>$(RepoRoot).deps/occt-testdata/opencascade-dataset-7.9.0/</OcctTestDataDir>
    <!-- Kerf.Modeling, in the repository's modeling folder, which the Bento benchmark builds on this kernel -->
    <KerfModelingRoot Condition="'$(KerfModelingRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RepoRoot)../modeling/'))</KerfModelingRoot>
  </PropertyGroup>

  <!-- Packages: SemVer, with the changes in CHANGELOG.md -->
  <PropertyGroup>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>Kerf contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- LGPL 2.1 with the Open CASCADE exception, as OCCT itself; the SPDX expression isn't known to NuGet -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>Copyright (c) 2026 The Kerf contributors; derived from Open CASCADE Technology 8.0.1, copyright (c) 1999-2026 OPEN CASCADE SAS</Copyright>
    <PackageProjectUrl>https://github.com/renegadedynamics/kerf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/renegadedynamics/kerf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(RepoRoot)README.md;$(RepoRoot)LICENSE;$(RepoRoot)OCCT_LGPL_EXCEPTION.txt;$(RepoRoot)NOTICE;$(RepoRoot)THIRD-PARTY-NOTICES.md;$(RepoRoot)CHANGELOG.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
