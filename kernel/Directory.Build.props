<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- Ported code keeps OCCT's names (gp_Pnt, myLocation, theAxis), so .NET naming rules don't apply -->
    <NoWarn>$(NoWarn);CS8981;IDE1006</NoWarn>
    <!-- The OCCT source this port follows (occt-version.json); tools/get-occt.ps1 fetches it here -->
    <OcctSourceDir>$(RepoRoot).deps/occt-src/</OcctSourceDir>
    <!-- OCCT's test data (tools/get-occt-testdata.ps1), which the Draw corpus restores: CSF_TestDataPath in OCCT -->
    <OcctTestDataDir>$(RepoRoot).deps/occt-testdata/opencascade-dataset-7.9.0/</OcctTestDataDir>
    <!-- A sibling build123d.NET checkout, whose native OCCT build the oracle tests compare against -->
    <Build123dNetRoot Condition="'$(Build123dNetRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RepoRoot)../build123d.net/'))</Build123dNetRoot>
  </PropertyGroup>

  <!-- Packages: SemVer, with the changes in CHANGELOG.md -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>OCCT.NET contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- LGPL 2.1 with the Open CASCADE exception, as OCCT itself; the SPDX expression isn't known to NuGet -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>Copyright (c) 2026 The OCCT.NET Contributors; based on Open CASCADE Technology, copyright (c) 1999-2026 OPEN CASCADE SAS</Copyright>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(RepoRoot)README.md;$(RepoRoot)LICENSE;$(RepoRoot)OCCT_LGPL_EXCEPTION.txt;$(RepoRoot)NOTICE;$(RepoRoot)THIRD-PARTY-NOTICES.md;$(RepoRoot)CHANGELOG.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
