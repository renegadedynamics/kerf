<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsOcctPort Condition="'$(MSBuildProjectName)' != 'Kerf.Analyzers'">true</IsOcctPort>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsOcctPort)' == 'true'">
    <!-- OCCT's free functions (RealSmall(), Square(), IsOdd(), the Raise_if checks) are called unqualified, as in C++ -->
    <Using Include="Kerf.Engine.Foundation.Standard" Static="true" />
    <!-- OCCT's typedefs math_Vector and math_IntegerVector: using aliases of math_VectorBase<T> -->
    <Using Include="Kerf.Engine.Numerics.VectorBase&lt;double&gt;" Alias="math_Vector" />
    <Using Include="Kerf.Engine.Numerics.VectorBase&lt;int&gt;" Alias="math_IntegerVector" />
    <!-- Checks ported code for mutating calls that would land on a defensive copy (docs/translation-rules.md) -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)Kerf.Analyzers/Kerf.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Every Kerf assembly may use the internal mutators of the others -->
    <InternalsVisibleTo Include="Kerf.Kernel.ModelingData" />
    <InternalsVisibleTo Include="Kerf.Kernel.ModelingAlgorithms" />
    <InternalsVisibleTo Include="Kerf.Kernel.DataExchange" />
    <!-- and so may the tests (ported GTests call OCCT's mutators, as the C++ tests do) -->
    <InternalsVisibleTo Include="Kerf.Kernel.Foundation.Tests" />
    <InternalsVisibleTo Include="Kerf.Kernel.ModelingData.Tests" />
    <InternalsVisibleTo Include="Kerf.Kernel.ModelingAlgorithms.Tests" />
    <InternalsVisibleTo Include="Kerf.Kernel.DataExchange.Tests" />
    <InternalsVisibleTo Include="Kerf.Kernel.Oracle.Tests" />
    <InternalsVisibleTo Include="Kerf.Kernel.DrawLite" />
    <InternalsVisibleTo Include="Kerf.Kernel.DrawLite.Tests" />
    <!-- The benchmarks measure the engine's own algorithms (Bento's benchmark is on the public API, and needs nothing here) -->
    <InternalsVisibleTo Include="Kerf.Kernel.Benchmarks" />
    <!-- The modelling layer's tests that check it against the engine itself (the STEP writer's document, the BRep reader):
         the modelling layer is on the public API alone (unit 10M1) -->
    <InternalsVisibleTo Include="Build123d.Tests" />
  </ItemGroup>
</Project>
