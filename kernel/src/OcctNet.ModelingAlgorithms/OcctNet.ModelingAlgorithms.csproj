<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Occt</RootNamespace>
    <Description>OCCT.NET modelling algorithms: a managed port of OCCT's TKGeomAlgo, TKTopAlgo and TKPrim (intersections, classification, topological algorithms, primitives).</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Ported members carry OCCT's documentation where it has some, not a comment on every overload -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcctNet.ModelingData\OcctNet.ModelingData.csproj" />
  </ItemGroup>

</Project>
