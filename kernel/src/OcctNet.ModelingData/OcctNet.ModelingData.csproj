<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Occt</RootNamespace>
    <Description>OCCT.NET modelling data: a managed port of OCCT's TKG2d, TKG3d, TKGeomBase and TKBRep (curves, surfaces, adaptors, topology).</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Ported members carry OCCT's documentation where it has some, not a comment on every overload -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcctNet.Foundation\OcctNet.Foundation.csproj" />
  </ItemGroup>

</Project>
