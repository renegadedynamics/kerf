<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Kerf.Engine</RootNamespace>
    <Description>Kerf.Kernel modelling algorithms, derived from Open CASCADE Technology 8.0.1 (Open Cascade SAS), ported to C# and redesigned: a port of OCCT's TKGeomAlgo, TKTopAlgo and TKPrim (intersections, classification, topological algorithms, primitives).</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kerf.Kernel.ModelingData\Kerf.Kernel.ModelingData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The default font, Liberation Sans 2.1.5 (SIL Open Font Licence 1.1, in THIRD-PARTY-NOTICES.md), gzipped (unit 13D) -->
    <EmbeddedResource Include="Fonts\Resources\LiberationSans-*.ttf.gz" LogicalName="Kerf.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
