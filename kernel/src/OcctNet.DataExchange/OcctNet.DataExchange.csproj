<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Occt</RootNamespace>
    <Description>OCCT.NET data exchange: a managed port of OCCT's TKXSBase, TKDESTEP and TKDESTL (the exchange framework, STEP, STL), with an immutable assembly tree in place of XCAF.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Ported members carry OCCT's documentation where it has some, not a comment on every overload -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Where .NET's encodings differ from OCCT's code tables (Resource_Unicode), OCCT's values: made by
         StepDataNativeTests from tools/stepdatarec's table dump (unit 8B, decision 1191) -->
    <EmbeddedResource Include="Resource\Resource_UnicodeTables.diff.gz" LogicalName="Occt.Resource.Resource_UnicodeTables.diff.gz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcctNet.ModelingAlgorithms\OcctNet.ModelingAlgorithms.csproj" />
  </ItemGroup>

</Project>
