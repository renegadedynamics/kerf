<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Occt</RootNamespace>
    <Description>OCCT.NET foundation: a managed port of OCCT's Standard, Precision and maths packages (gp, ...).</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Ported members carry OCCT's documentation where it has some, not a comment on every overload -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- OCCT's math_Vector and math_IntegerVector are using aliases of math_VectorBase<T>; so are these -->
    <Using Include="Occt.math_VectorBase&lt;double&gt;" Alias="math_Vector" />
    <Using Include="Occt.math_VectorBase&lt;int&gt;" Alias="math_IntegerVector" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OcctNet.Foundation.Tests" />
    <InternalsVisibleTo Include="OcctNet.Oracle.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packed locally by tools/pack-bento.ps1 until it is published -->
    <PackageReference Include="Bento.Collections" Version="0.4.0" />
  </ItemGroup>

</Project>
