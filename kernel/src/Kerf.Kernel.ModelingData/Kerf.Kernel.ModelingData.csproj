<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Kerf.Engine</RootNamespace>
    <Description>Kerf.Kernel modelling data, derived from Open CASCADE Technology 8.0.1 (Open Cascade SAS), ported to C# and redesigned: a port of OCCT's TKG2d, TKG3d, TKGeomBase and TKBRep (curves, surfaces, adaptors, topology).</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Ported members carry OCCT's documentation where it has some, not a comment on every overload -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kerf.Kernel.Foundation\Kerf.Kernel.Foundation.csproj" />
  </ItemGroup>

</Project>
